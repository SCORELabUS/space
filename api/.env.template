# ---------- SERVER CONFIGURATION ----------

ALLOWED_ORIGINS= # OPTIONAL: Semicolon-separated list of allowed origins for CORS. If not provided, it defaults to "*".

# ---------- DATABASE CONFIGURATION (MongoDB) ----------

DATABASE_NAME= # OPTIONAL: Database name. If not provided, SPACE will use "space_db" as default value.
               # If MONGO_URI is provided, this value will be ignored.

DATABASE_USERNAME= # OPTIONAL: Database username. If not provided, SPACE will use "mongoUser" as default value.
                   # If MONGO_URI is provided, this value will be ignored.

DATABASE_PASSWORD= # OPTIONAL: Database password. If not provided, SPACE will use "mongoPassword" as default value.
                   # If MONGO_URI is provided, this value will be ignored.

MONGO_AUTH_SOURCE= # OPTIONAL: MongoDB authentication database (use "admin" with the shared local root user).

MONGO_URI= # OPTIONAL: MongoDB connection string. If not provided, SPACE will 
           # use "mongodb://${dbCredentials}localhost:27017/${dbName}" as default 
           # value, where dbCredentials correspond to the formated version of 
           # DATABASE_USERNAME and DATABASE_PASSWORD, and dbName corresponds to DATABASE_NAME.

# ---------- CACHE CONFIGURATION (Redis) ----------

REDIS_URL= # REQUIRED: Redis URL for caching.
REDIS_KEY_PREFIX=space: # Prefix used to isolate SPACE cache keys on a shared Redis instance.
REDIS_SOCKET_KEY=space:socket.io # Prefix used by the Socket.IO Redis adapter.

# ---------- JWT CONFIGURATION ----------

JWT_SECRET= # REQUIRED: JWT secret key.

JWT_SALT= # REQUIRED: JWT salt for hashing.

JWT_EXPIRATION= # OPTIONAL: JWT expiration time (in duration format, e.g., 1d, 2h). If not provided, SPACE will use "1h" as default value.

JWT_ISSUER= # OPTIONAL: `iss` claim of the pricing tokens, identifying this SPACE server (e.g. its public URL). If not provided, SPACE will use "space". Set a distinct value per server when several servers share a JWT secret.

# ---------- SPHERE ----------

SPHERE_KEY_ENCRYPTION_KEY= # OPTIONAL: 32 bytes (base64, 44 characters, or hex, 64 characters; e.g. `openssl rand -base64 32`) used to encrypt the SPHERE API keys of linked services (private pricings). Without it, sphereApiKey is rejected.

SPHERE_KEY_ENCRYPTION_KEY_PREVIOUS= # OPTIONAL: the previous SPHERE_KEY_ENCRYPTION_KEY while rotating it. Stored keys it decrypts are re-encrypted with the current key on use; remove it once every linked service has synchronized.

SPACE_PRIVATE_FILES_DIR= # OPTIONAL: directory (outside public/) for files that must not be served without authorisation, such as private SPHERE snapshots. Default: ./private. Persist it like public/.

# ---------- USAGE CONSUMPTION ----------

CONSUMPTION_RETENTION_SECONDS= # OPTIONAL: how long an applied consumption can be reverted by its consumptionId (seconds, at least 60). Default: 86400 (24 hours).

IDEMPOTENCY_KEY_TTL_SECONDS= # OPTIONAL: how long an Idempotency-Key and its stored response are kept (seconds). Default: 86400 (24 hours). Keep it at most CONSUMPTION_RETENTION_SECONDS, so that a replayed consumptionId can still be reverted.

IDEMPOTENCY_WAIT_MS= # OPTIONAL: how long a request waits for a concurrent request with the same Idempotency-Key before answering 409 IDEMPOTENCY_IN_PROGRESS (milliseconds). Default: 2000.

# ---------- EVENTS ----------

ENABLE_TEST_EVENTS= # OPTIONAL: "true" enables POST /events/test-event when ENVIRONMENT=production (disabled there by default).

# ---------- FILES ----------

SPACE_PRIVATE_FILES_DIR= # OPTIONAL: directory for pricing files (uploaded pricings and SPHERE snapshots), which are only served to authorised callers through GET .../pricings/{version}?format=yaml. Must not be inside public/, which is served without authentication. Default: ./private. Persist it like public/.

# ---------- DEFAULT USER CONFIGURATION ----------

ADMIN_USER= # OPTIONAL: Username for the default admin user. If not provided, SPACE will use "admin" as default value.

ADMIN_PASSWORD= # OPTIONAL: Password for the default admin user. If not provided, SPACE will use "space4all" as default value.
